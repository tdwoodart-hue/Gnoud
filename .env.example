# APP_URL: Public URL where the app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Web Push keys. Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:your-email@example.com"
FIRESTORE_DATABASE_ID="(default)"

# Required on Vercel. Paste the complete Firebase service-account JSON as one secret value.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Vercel automatically sends this secret to /api/notifications/cron.
CRON_SECRET=""

# Optional: unlocks the large Google Cloud Vietnamese voice pack in Reader.
# Enable Cloud Text-to-Speech API for the key's project before using it.
GOOGLE_TTS_API_KEY=""

# Optional: Microsoft Azure Speech voices for Reader (Hoài My / Nam Minh).
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""
